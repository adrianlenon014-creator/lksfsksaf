# VITE_API_URL: Public URL of the Express API used by the frontend.
# For the current deployment, use https://lksfsksaf.onrender.com.
VITE_API_URL="https://lksfsksaf.onrender.com"

# APP_URL: Public URL where the app is hosted.
APP_URL="https://lksfsksaf.onrender.com"

# WHOPS_API_KEY: Required for payment processing via Whops.com.
# Add your secret Whops API key here. It must remain server-side only.
WHOPS_API_KEY="whop_key_..."

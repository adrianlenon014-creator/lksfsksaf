# VITE_API_URL: Public URL of the Express API used by the frontend.
# For the current deployment, use https://lksfsksaffff.onrender.com.
VITE_API_URL="https://lksfsksafff.onrender.com"

# APP_URL: Public URL where the app is hosted.
APP_URL="https://lksfsksafff.onrender.com"

# WHOP_API_KEY: Required for payment processing via Whop.com.
# Add your secret Whops API key here. It must remain server-side only.
WHOP_API_KEY="whop_key_..."

# WHOP_ACCOUNT_ID: Your Whop business/account ID, for example biz_....
WHOP_ACCOUNT_ID="biz_..."
